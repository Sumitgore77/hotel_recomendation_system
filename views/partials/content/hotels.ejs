<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Hotel</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      background-color: #f8f9fa;
      margin: 0;
    }

    .container {
      max-width: 1000px;
      margin: auto;
    }

    .card {
      padding: 1.5rem;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
    }

    .form-label {
      font-size: 0.9rem;
      margin-bottom: 0.3rem;
    }

    .form-control {
      font-size: 0.9rem;
      padding: 0.4rem 0.6rem;
    }

    .btn {
      font-size: 0.9rem;
    }

    .text-danger {
      font-size: 0.8rem;
    }
  </style>
</head>
<body>
  <div class="container mt-4">
    <div class="card">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Add New Hotel</h2>
        <a href="/dashboard?section=view-hotels" class="btn btn-dark btn-sm">View Hotels</a>
      </div>

      <form id="hotelForm" novalidate action="/admin/add-hotel" method="POST" enctype="multipart/form-data" novalidate >
        <div class="row">
          <div class="mb-3 col-md-6">
            <label class="form-label">Hotel Name</label>
            <input type="text" class="form-control" name="name" id="name" required>
            <div class="text-danger" id="nameError"></div>
          </div>

          <div class="mb-3 col-md-6">
            <label class="form-label">Address</label>
            <input type="text" class="form-control" name="address" id="address" required>
            <div class="text-danger" id="addressError"></div>
          </div>

          <div class="mb-3 col-md-6">
            <label class="form-label">City</label>
            <input type="text" class="form-control" name="city_name" id="city" required>
            <div class="text-danger" id="cityError"></div>
          </div>

          <div class="mb-3 col-md-6">
            <label class="form-label">Area</label>
            <input type="text" class="form-control" name="area_name" id="area" required>
            <div class="text-danger" id="areaError"></div>
          </div>

          <div class="mb-3 col-md-6">
            <label class="form-label">Hotel Email</label>
            <input type="email" class="form-control" name="email" id="email" required>
            <div class="text-danger" id="emailError"></div>
          </div>

          <div class="mb-3 col-md-6">
            <label class="form-label">Hotel Contact</label>
            <input type="text" class="form-control" name="contact" id="contact" required>
            <div class="text-danger" id="contactError"></div>
          </div>

          <div class="mb-3 col-md-6">
            <label class="form-label">Room Types</label>
            <input type="text" class="form-control" name="room_type" id="room_type" required>
            <div class="text-danger" id="roomError"></div>
          </div>

          <div class="mb-3 col-md-6">
            <label class="form-label">Price (per night)</label>
            <input type="text" class="form-control" name="price" id="price" required>
            <div class="text-danger" id="priceError"></div>
          </div>

          <div class="mb-3 col-md-6">
            <label class="form-label">Image</label>
            <input type="file" class="form-control" name="image" id="image" accept="image/png,image/jpeg" required>
            <small class="text-muted">Only JPG, JPEG, PNG formats allowed. Max size: 2MB.</small>
            <div class="text-danger" id="imageError"></div>
          </div>

          <div class="mb-3 col-md-6">
            <label class="form-label">Amenities</label>
            <input type="text" class="form-control" name="amenities" id="amenities" required>
            <div class="text-danger" id="amenitiesError"></div>
          </div>
        </div>

        <button type="submit" class="btn btn-dark w-100 mt-3">Add Hotel</button>
      </form>
    </div>
  </div>

  <script>
  const maxSize = 30 * 1024 * 1024;
  const form = document.querySelector("form");

  const fields = {
    name: {
      regex: /^[^\s][\w\s]{2,50}$/,
      error: "Hotel name must be at least 3 characters.",
    },
    address: {
      regex: /^[^\s].{5,100}$/,
      error: "Enter a valid address (min 5 characters).",
    },
    city_name: {
      regex: /^[^\s][A-Za-z\s]{2,}$/,
      error: "Enter a valid city name.",
    },
    area_name: {
      regex: /^[^\s][A-Za-z0-9\s]{2,}$/,
      error: "Enter a valid area name.",
    },
    email: {
      regex: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
      error: "Invalid email format.",
    },
    contact: {
      regex: /^[6-9]\d{9}$/,
      error: "Invalid contact number.",
    },
    room_type: {
      regex: /^[^\s].{1,100}$/,
      error: "Enter at least one room type (comma-separated).",
    },
    price: {
      regex: /^([0-9]+(\.[0-9]{1,2})?\s*,?\s*)+$/,
      error: "Enter valid prices, comma-separated (e.g., 1000, 2000).",
    },
    amenities: {
      regex: /^[^\s].*$/,
      error: "Enter amenities (comma-separated).",
    },
  };

  Object.keys(fields).forEach(field => {
    const input = document.getElementsByName(field)[0];
    const errorId = field + "Error";

    // Create error message span if not already there
    if (!document.getElementById(errorId)) {
      const errorSpan = document.createElement("div");
      errorSpan.className = "text-danger mt-1";
      errorSpan.id = errorId;
      input.parentNode.appendChild(errorSpan);
    }

    input.addEventListener("input", () => {
      const value = input.value.trimStart();
      input.value = value;
      const error = document.getElementById(errorId);

      if (!fields[field].regex.test(value)) {
        error.textContent = fields[field].error;
      } else {
        error.textContent = "";
      }
    });
  });

  form.addEventListener("submit", function (e) {
    let isValid = true;

    // Validate all fields
    Object.keys(fields).forEach(field => {
      const input = document.getElementsByName(field)[0];
      const error = document.getElementById(field + "Error");
      const value = input.value.trimStart();
      input.value = value;

      if (!fields[field].regex.test(value)) {
        error.textContent = fields[field].error;
        isValid = false;
      } else {
        error.textContent = "";
      }
    });

    // Validate room types vs prices count
    const roomTypeStr = document.getElementsByName("room_type")[0].value.trim();
    const priceStr = document.getElementsByName("price")[0].value.trim();
    const roomTypes = roomTypeStr.split(",").map(r => r.trim()).filter(Boolean);
    const prices = priceStr.split(",").map(p => p.trim()).filter(p => !isNaN(p));

    if (roomTypes.length !== prices.length) {
      document.getElementById("priceError").textContent = "Room types and prices count must match.";
      isValid = false;
    }

    // Validate image file
    const imageInput = document.querySelector('input[name="image"]');
    const imageErrorId = "imageError";
    if (!document.getElementById(imageErrorId)) {
      const errorSpan = document.createElement("div");
      errorSpan.className = "text-danger mt-1";
      errorSpan.id = imageErrorId;
      imageInput.parentNode.appendChild(errorSpan);
    }
    const imageError = document.getElementById(imageErrorId);

    if (imageInput.files.length > 0) {
      const file = imageInput.files[0];
      const allowedTypes = ["image/jpeg", "image/png", "image/jpg"];

      if (!allowedTypes.includes(file.type)) {
        imageError.textContent = "Only JPG or PNG files are allowed.";
        isValid = false;
      } else if (file.size > maxSize) {
        imageError.textContent = "Image must be less than 2MB.";
        isValid = false;
      } else {
        imageError.textContent = "";
      }
    }

    if (!isValid) {
      e.preventDefault(); // ❗ prevent actual submission
    }
  });
</script>

</body>
</html>
