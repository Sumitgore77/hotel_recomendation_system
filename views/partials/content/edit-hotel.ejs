<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Hotel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .edit-hotel-form {
      max-width: 700px;
      margin: 0 auto;
      padding: 25px;
      background-color: #ffffff;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
    }

    .edit-hotel-form h2 {
      text-align: center;
      margin-bottom: 25px;
    }

    .image-preview {
      width: 100%;
      max-height: 200px;
      object-fit: cover;
      margin-bottom: 15px;
      border: 1px solid #ccc;
      border-radius: 5px;
    }
  </style>
</head>
<body>

<div class="container mt-4">
  <div class="edit-hotel-form bg-white p-4 rounded shadow">
    <h2>Edit Hotel</h2>

    <form action="/admin/update-hotel/<%= hotel.hotel_id %>" method="POST" enctype="multipart/form-data">
      <div class="mb-3">
        <label class="form-label">Hotel Name</label>
        <input type="text" name="hotel_name" class="form-control" value="<%= hotel.hotel_name %>" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Hotel Address</label>
        <input type="text" name="hotel_address" class="form-control" value="<%= hotel.hotel_address %>" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="hotel_email" class="form-control" value="<%= hotel.hotel_email %>" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Contact</label>
        <input type="text" name="hotel_contact" class="form-control" value="<%= hotel.hotel_contact %>" required>
      </div>

      <div class="mb-3">
        <label class="form-label">City</label>
        <input type="text" name="city_name" class="form-control" value="<%= hotel.city_name %>" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Area</label>
        <input type="text" name="area_name" class="form-control" value="<%= hotel.area_name %>"  readonly>
        <small class="text-muted">Read Only (Not Update)</small>
      </div>

      <div class="mb-3">
        <label class="form-label">Amenities</label>
        <input type="text" name="amenities" class="form-control" placeholder="e.g. WiFi, Parking, Pool" value="<%= hotel.amenities ? hotel.amenities.join(', ') : '' %>">
        <small class="text-muted">Separate amenities with commas.</small>
      </div>

      <% if (hotel.image) { %>
        <div class="mb-3">
          <label class="form-label">Current Image</label><br>
          <img src="/uploads/<%= hotel.image %>" class="image-preview" alt="Current Hotel Image">
        </div>
      <% } %>

      <div class="mb-3">
        <label class="form-label">Update Hotel Image</label>
        <input type="file" name="hotel_image" class="form-control">
      </div>

      <button type="submit" class="btn btn-dark w-100">Update Hotel</button>
    </form>
  </div>
</div>
<script>
  const form = document.querySelector("form");

  const fields = {
    hotel_name: {
      regex: /^[^\s][\w\s]{2,50}$/,
      error: "Hotel name must be at least 3 characters.",
    },
    hotel_address: {
      regex: /^[^\s].{5,100}$/,
      error: "Enter a valid address (min 5 characters).",
    },
    hotel_email: {
      regex: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
      error: "Invalid email format.",
    },
    hotel_contact: {
      regex: /^[6-9]\d{9}$/,
      error: "Invalid contact number.",
    },
    city_name: {
      regex: /^[^\s][A-Za-z\s]{2,}$/,
      error: "Enter a valid city name.",
    },
    area_name: {
      regex: /^[^\s][A-Za-z0-9\s]{2,}$/,
      error: "Enter a valid area name.",
    },
    amenities: {
      regex: /^.{0,255}$/, // Optional but limited to 255 chars
      error: "Amenities should be comma-separated text.",
    }
  };

  Object.keys(fields).forEach(field => {
    const input = document.getElementsByName(field)[0];
    const errorId = field + "Error";

    if (!document.getElementById(errorId)) {
      const errorSpan = document.createElement("div");
      errorSpan.className = "text-danger mt-1";
      errorSpan.id = errorId;
      input.parentNode.appendChild(errorSpan);
    }

    input.addEventListener("input", () => {
      const value = input.value.trimStart();
      input.value = value;
      const error = document.getElementById(errorId);

      if (!fields[field].regex.test(value)) {
        error.textContent = fields[field].error;
      } else {
        error.textContent = "";
      }
    });
  });

  form.addEventListener("submit", function (e) {
    let isValid = true;

    Object.keys(fields).forEach(field => {
      const input = document.getElementsByName(field)[0];
      const value = input.value.trimStart();
      input.value = value;
      const error = document.getElementById(field + "Error");

      if (!fields[field].regex.test(value)) {
        error.textContent = fields[field].error;
        isValid = false;
      } else {
        error.textContent = "";
      }
    });

    // Validate image if new one is uploaded
    const imageInput = document.getElementsByName("hotel_image")[0];
    const imageErrorId = "hotel_imageError";

    if (!document.getElementById(imageErrorId)) {
      const errorSpan = document.createElement("div");
      errorSpan.className = "text-danger mt-1";
      errorSpan.id = imageErrorId;
      imageInput.parentNode.appendChild(errorSpan);
    }

    const imageError = document.getElementById(imageErrorId);
    if (imageInput.files.length > 0) {
      const file = imageInput.files[0];
      const allowedTypes = ["image/jpeg", "image/png", "image/jpg"];
     

      if (!allowedTypes.includes(file.type)) {
        imageError.textContent = "Only JPG, JPEG, or PNG images allowed.";
        isValid = false;
      } else if (file.size > maxSize) {
        imageError.textContent = "Image must be less than 2MB.";
        isValid = false;
      } else {
        imageError.textContent = "";
      }
    } else {
      imageError.textContent = "";
    }

    if (!isValid) {
      e.preventDefault();
    }
  });
</script>

</body>
</html>
