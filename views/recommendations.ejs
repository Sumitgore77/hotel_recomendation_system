<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Hotel Recommendations</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/CSS/user-dashboard.css">
</head>

<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow sticky-top">
    <div class="container">
      <a class="navbar-brand" href="/user/home">🏨 Hotel Recommender</a>
      <a class="btn btn-outline-light ms-auto" href="/user/home">Back to Dashboard</a>
    </div>
  </nav>

  <div class="container mt-4">
    <h3 class="mb-4 text-center">Recommended Hotels for You</h3>

    <% if (recommendations.length > 0) { %>
      <div class="row">
        <% recommendations.forEach(hotel => {
          const amenityArray = hotel.amenities ? hotel.amenities.split(',').map(a => a.trim()) : [];
        %>
        <div class="col-md-4 mb-4">
          <div class="card h-100 hotel-card shadow" data-bs-toggle="modal" data-bs-target="#hotelModal<%= hotel.hotel_id %>">
            <img src="/uploads/<%= hotel.image %>" class="card-img-top" alt="Hotel Image" style="height: 200px; object-fit: cover;">
            <div class="card-body">
              <h5 class="card-title text-primary"><%= hotel.hotel_name %></h5>
              <p class="card-text"><strong>City:</strong> <%= hotel.city_name %></p>
              <p class="card-text"><strong>Area:</strong> <%= hotel.area_name %></p>
            </div>
          </div>
        </div>

        <!-- Modal -->
        <div class="modal fade" id="hotelModal<%= hotel.hotel_id %>" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content bg-dark text-white">
              <div class="modal-header">
                <h5 class="modal-title text-warning"><%= hotel.hotel_name %></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <div class="row g-3">
                  <div class="col-md-5">
                    <img src="/uploads/<%= hotel.image %>" class="img-fluid rounded shadow" alt="Hotel Image" />
                  </div>
                  <div class="col-md-7">
                    <p><i class="fas fa-map-marker-alt text-info me-2"></i><strong>City:</strong> <%= hotel.city_name %></p>
                    <p><i class="fas fa-location-arrow text-light me-2"></i><strong>Area:</strong> <%= hotel.area_name %></p>
                    <p><i class="fas fa-cogs text-secondary me-2"></i><strong>Amenities:</strong></p>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                      <% amenityArray.forEach(am => { %>
                        <span class="badge bg-light text-dark"><i class="fa fa-check text-success me-1"></i><%= am %></span>
                      <% }) %>
                    </div>
                    <p><i class="fas fa-door-open text-primary me-2"></i><strong>Room Types:</strong> <%= hotel.room_types || 'N/A' %></p>
                  </div>
                </div>
              </div>
              <div class="modal-footer border-top border-secondary">
                <a href="/user/book/<%= hotel.hotel_id %>" class="btn btn-success">Book Now</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="alert alert-warning text-center">No recommendations available at the moment.</div>
    <% } %>
  </div>

  <footer class="bg-dark text-white text-center py-3 mt-4">
    <small>© <%= new Date().getFullYear() %> Hotel Recommendation System. All rights reserved.</small>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" defer></script>
</body>

</html>
